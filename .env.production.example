# Production env template for the Hostinger deploy.
#
# Do NOT copy the local .env to the server -- it points at your local XAMPP
# MySQL and has APP_DEBUG=true, which leaks stack traces publicly (we hit
# this ourselves during testing: an auth error dumped full file paths and
# internal structure in the response). This file has the production-safe
# values already filled in where they don't depend on Hostinger's specifics;
# copy it to `.env` ON THE SERVER and fill in the four DB_* values and
# APP_URL from hPanel.
#
# The APP_KEY below was freshly generated (`php artisan key:generate --show`)
# -- it is NOT the same key as the local .env. Never reuse a dev key on a
# public server: anyone with that key could forge signed data
# (password-reset tokens, encrypted cookies, etc.) against the live site.

APP_NAME=ClassSync
APP_ENV=production
APP_KEY=base64:CLQ50qLIsWTwdZhOo5QkiwztOKAgzfkR4em4bQK7Tcg=
APP_DEBUG=false
# From hPanel, e.g. https://plum-rail-553527.hostingersite.com or your domain.
# No trailing slash, no /public -- Hostinger's Laravel installer points the
# web root at /public for you.
APP_URL=https://REPLACE-WITH-YOUR-HOSTINGER-URL

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# "debug" is fine locally; on a public server it's noisy and can end up
# logging sensitive request data. "error" is enough to catch real problems.
LOG_LEVEL=error

DB_CONNECTION=mysql
# hPanel -> Databases -> MySQL Databases. Hostinger's DB host is usually
# "localhost", but confirm it there -- don't assume.
DB_HOST=REPLACE-WITH-HOSTINGER-DB-HOST
DB_PORT=3306
DB_DATABASE=REPLACE-WITH-HOSTINGER-DB-NAME
DB_USERNAME=REPLACE-WITH-HOSTINGER-DB-USER
DB_PASSWORD=REPLACE-WITH-HOSTINGER-DB-PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# The API is served over https:// in production -- cookies (Sanctum's CSRF
# cookie, if ever used from a browser) should require it.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Google sign-in (POST /api/auth/google). Google Cloud Console -> APIs &
# Services -> Credentials: the client ID of the *Web application* OAuth
# client (not the Android/iOS ones). Sign-in refuses every request until
# this is set.
GOOGLE_CLIENT_ID=
# The school's Google Workspace domain (e.g. myschool.edu) so only school
# accounts can sign in. If students are in a separate Workspace with its
# own domain, list both: myschool.edu,students.myschool.edu. Blank = any
# Google account (not recommended for a Workspace school).
GOOGLE_ALLOWED_DOMAIN=
